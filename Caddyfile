passhub.abel.dev.br {
	# UI do Jaeger em /traces. O Jaeger roda com --query.base-path=/traces,
	# então espera receber o prefixo intacto — por isso `handle` e não
	# `handle_path` (que removeria /traces e faria o SPA buscar /api/...).
	handle /traces/* {
		reverse_proxy jaeger:16686
	}

	handle {
		reverse_proxy api:8000
	}

	encode gzip
}