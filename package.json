{
  "name": "passhub-desafio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "prettier": "^2.7.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "content-disposition": "^0.5.4"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^5.2.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation-fastify": "^0.56.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@upstash/redis": "^1.41.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "undici": "^7.2.0",
    "zod": "^4.6.7"
  }
}
